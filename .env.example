# Copy to .env for local use (never commit .env). Real values go in GitHub/Render/Vercel settings.

# Database: leave DATABASE_URL empty to use the local SQLite file below.
DATABASE_URL=
# e.g. postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DQ_DB_PATH=data/edwh.db

LOG_FILE=logs/etl.log
SLACK_WEBHOOK_URL=

# API (production): the dashboard's URL, comma-separated for several
CORS_ORIGINS=

# Dashboard build (set in Vercel): the deployed API's URL
# VITE_API_BASE=https://dq-api.onrender.com
